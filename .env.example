# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=us-east-1

# Google Drive
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Azure Blob
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=

# GCP
GCP_PROJECT_ID=
GCP_KEY_FILE=
GCP_BUCKET=

# Dropbox
DROPBOX_ACCESS_TOKEN=

# FTP
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
FTP_PATH=/uploads

# SSH Deployment
SSH_HOST=
SSH_USER=
SSH_KEY=
SSH_DEPLOY_PATH=/var/www/app

# Docker Deployment
# Image name is required. Leave DOCKER_IMAGE_TAG unset for a unique tag per build.
DOCKER_IMAGE_NAME=
# OPTIONAL — unique tag per build unless you set this explicitly
DOCKER_IMAGE_TAG=
# OPTIONAL — only for private / non-Docker-Hub registries
DOCKER_REGISTRY_URL=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_TOKEN=
#
# Remote Linux via SSH (remote.mode: "ssh" in deployhub.config.json):
# same names as EC2. Prefer this over DOCKER_HOST=ssh:// — doctor can validate
# the key, host, remote daemon, and docker-group permissions.
# SSH_HOST=
# SSH_USER=
# SSH_KEY_PATH=
# SSH_KEY=
#
# Advanced raw Docker host URI (remote.mode: "raw") — Docker CLI ssh:// or tcp://.
# DeployHub cannot validate this; depends on your local SSH/TLS config.
# DOCKER_HOST=
# DOCKER_TLS_VERIFY=
# DOCKER_CERT_PATH=

# Notifications
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=
NOTIFY_EMAIL_TO=
WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
